# Template for .env. Copy it and fill in the blanks:
#
#   cp .env.example .env
#
# .env is git-ignored; this file is committed and must never contain a real secret.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# POSTGRES_* configure the local container in docker-compose.yml.
# DATABASE_* configure the application. They describe the same database.
POSTGRES_DB=io
POSTGRES_USER=io
POSTGRES_PASSWORD=io

DATABASE_URL=jdbc:postgresql://localhost:5432/io
DATABASE_USERNAME=io
DATABASE_PASSWORD=io

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Required - the application refuses to start without it. At least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Required. Absolute URI identifying this deployment - the API's own base URL.
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------------------
# Rate limiting (/api/auth/**)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_WINDOW=1m
# Behind Cloudflare set this to CF-Connecting-IP. Leave empty when nothing trusted sits
# in front, otherwise a caller can forge the header and get a fresh bucket per request.
RATE_LIMIT_CLIENT_IP_HEADER=
