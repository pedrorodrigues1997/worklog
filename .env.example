# Template for .env. Copy it and fill in the blanks:
#
#   cp .env.example .env
#
# .env is git-ignored; this file is committed and must never contain a real secret.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# POSTGRES_* configure the local container in docker-compose.yml.
# DATABASE_* configure the application. They describe the same database.
POSTGRES_DB=io
POSTGRES_USER=io
POSTGRES_PASSWORD=io

DATABASE_URL=jdbc:postgresql://localhost:5432/io
DATABASE_USERNAME=io
DATABASE_PASSWORD=io

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Required - the application refuses to start without it. At least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Required. Absolute URI identifying this deployment - the API's own base URL.
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------------------
# Rate limiting (/api/auth/**)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_WINDOW=1m
# Behind Cloudflare set this to CF-Connecting-IP. Leave empty when nothing trusted sits
# in front, otherwise a caller can forge the header and get a fresh bucket per request.
RATE_LIMIT_CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
# Leave blank to run without OAuth - no provider is registered and the OAuth endpoints
# do not exist. Set both to switch Google sign-in on.
#
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   Authorised redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser is sent after a provider sign-in. Never taken from the request.
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3000/auth/error

# --- Billing (Stripe) -------------------------------------------------------
# Optional. Leave blank to run without billing; the application starts either way.
# Never commit real values - this file is the committed template.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing
